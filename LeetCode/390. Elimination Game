class Solution:
    def lastRemaining(self, n: int) -> int:
        head = 1
        gap = 1
        remaining = n
        is_left_to_right = True

        while remaining > 1:
            if is_left_to_right or remaining % 2 == 1:
                head += gap

            gap *= 2
            remaining //= 2
            is_left_to_right = not is_left_to_right

        return head
