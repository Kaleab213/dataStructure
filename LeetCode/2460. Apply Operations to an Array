class Solution:
    def applyOperations(self, nums: List[int]) -> List[int]:
        for i in range(len(nums)-1):
            if nums[i] == nums[i+1]:
                nums[i]*=2
                nums[i+1]=0

        i, j = 0, 1
        while j < len(nums) and i < len(nums):
            if nums[i] == 0:
                if j <= i:
                    j = i + 1
                    
                while j < len(nums) and nums[j] == 0:
                    j += 1
                
                if j < len(nums):
                    nums[i], nums[j] = nums[j], nums[i]

            i += 1

        return nums
        
